#!/usr/bin/env bash
set -euo pipefail
IP="${ROBOLAB_DASHBOARD_IP:-$(ip -4 route get 1.1.1.1 | sed -n 's/.* src \([^ ]*\).*/\1/p')}"
systemctl --user start robolab-cloud-dashboard-tunnel.service
for _ in $(seq 1 20); do
  curl -fs "http://$IP:8080/api/runs" >/dev/null 2>&1 && break
  sleep 1
done
curl -fsS "http://$IP:8080/api/runs" >/dev/null
exec xdg-open "http://$IP:8080"
